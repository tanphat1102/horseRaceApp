<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chọn ngựa"
        android:textStyle="bold"
        android:textSize="16sp"
        android:paddingBottom="8dp" />

    <RadioGroup
        android:id="@+id/rgHorses"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/rbHorse2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ngựa Đen" />

        <RadioButton
            android:id="@+id/rbHorse3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ngựa Nâu" />

        <RadioButton
            android:id="@+id/rbHorse4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ngựa Trắng" />
    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Số tiền cược"
        android:textStyle="bold"
        android:textSize="16sp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp" />

    <EditText
        android:id="@+id/etBetAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập số tiền cược"
        android:inputType="number"
        android:maxLines="1" />

</LinearLayout>
