<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_dialog_with_image">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎯 ĐẶT CƯỢC"
        android:textStyle="bold"
        android:textSize="24sp"
        android:textColor="#D4AF37"
        android:gravity="center"
        android:paddingBottom="20dp"
        android:shadowColor="#000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="3" />

    <!-- Chọn ngựa section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🐴 Chọn ngựa"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="#8B4513"
        android:paddingBottom="12dp" />

    <RadioGroup
        android:id="@+id/rgHorses"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_radio_group"
        android:padding="12dp"
        android:layout_marginBottom="20dp">

        <RadioButton
            android:id="@+id/rbHorse2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ngựa Đen"
            android:textSize="16sp"
            android:textColor="#1C1C1C"
            android:textStyle="bold"
            android:padding="14dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_radio_item"
            android:buttonTint="#1C1C1C"
            android:drawableStart="@drawable/horse_black"
            android:drawablePadding="12dp"
            android:gravity="center_vertical" />

        <RadioButton
            android:id="@+id/rbHorse3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ngựa Nâu"
            android:textSize="16sp"
            android:textColor="#8B4513"
            android:textStyle="bold"
            android:padding="14dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_radio_item"
            android:buttonTint="#8B4513"
            android:drawableStart="@drawable/horse_brown"
            android:drawablePadding="12dp"
            android:gravity="center_vertical" />

        <RadioButton
            android:id="@+id/rbHorse4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ngựa Trắng"
            android:textSize="16sp"
            android:textColor="#4A4A4A"
            android:textStyle="bold"
            android:padding="14dp"
            android:background="@drawable/bg_radio_item"
            android:buttonTint="#4A4A4A"
            android:drawableStart="@drawable/house_white"
            android:drawablePadding="12dp"
            android:gravity="center_vertical" />
    </RadioGroup>

    <!-- Số tiền cược section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💰 Số tiền cược"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="#8B4513"
        android:paddingBottom="12dp" />

    <EditText
        android:id="@+id/etBetAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập số tiền cược ($)"
        android:textColorHint="#A0826D"
        android:inputType="number"
        android:maxLines="1"
        android:padding="16dp"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#654321"
        android:background="@drawable/bg_edittext"
        android:autofillHints="betAmount" />

    <!-- Info text -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="✨ Thắng cược x2 tiền đặt!"
        android:textSize="14sp"
        android:textColor="#D4AF37"
        android:gravity="center"
        android:paddingTop="16dp"
        android:textStyle="bold|italic"
        android:shadowColor="#000000"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="2" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="24dp"
        android:gravity="center">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCancelBet"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="❌ Hủy"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_cancel"
            android:layout_marginEnd="8dp"
            android:padding="12dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnConfirmBet"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🎯 Xác nhận"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_confirm"
            android:layout_marginStart="8dp"
            android:padding="12dp" />
    </LinearLayout>

</LinearLayout>
