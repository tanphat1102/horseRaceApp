<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_dialog_with_image">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💰 NẠP TIỀN VÀO TÀI KHOẢN"
        android:textStyle="bold"
        android:textSize="24sp"
        android:textColor="#D4AF37"
        android:gravity="center"
        android:paddingBottom="16dp"
        android:shadowColor="#000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="3" />

    <!-- Message -->

    <!-- Input Amount -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_text_semitransparent"
        android:gravity="center"
        android:padding="12dp"
        android:text="Nhập số tiền bạn muốn nạp vào tài khoản"
        android:textColor="#654321"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/etDepositAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="💵 Nhập số tiền nạp ($)"
        android:textColorHint="#A0826D"
        android:inputType="number"
        android:maxLines="1"
        android:padding="16dp"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#654321"
        android:background="@drawable/bg_edittext"
        android:autofillHints="depositAmount" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="24dp"
        android:gravity="center">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCancelDeposit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="❌ Hủy"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_cancel"
            android:layout_marginEnd="8dp"
            android:padding="12dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnConfirmDeposit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="💵 Nạp tiền"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_confirm"
            android:layout_marginStart="8dp"
            android:padding="12dp" />
    </LinearLayout>

</LinearLayout>

