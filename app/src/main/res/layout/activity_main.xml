<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_landscape">

    <!-- Thanh thông tin phía trên -->

    <!-- Khu vực đường đua -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#AA000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <Button
            android:id="@+id/btnDeposit"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:backgroundTint="#4CAF50"
            android:text="Nạp tiền"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="TRƯỜNG ĐUA"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vốn: 100$"
            android:textColor="#FFEB3B"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar"
        android:layout_above="@id/bottomBar"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="10dp">

        <!-- Ngựa 1: Vàng -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="0dp">

            <CheckBox
                android:id="@+id/cbHorse1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:buttonTint="@android:color/white" />

            <SeekBar
                android:id="@+id/sbHorse1"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_toStartOf="@+id/etBet1"
                android:layout_toEndOf="@id/cbHorse1"
                android:enabled="false"
                android:max="100"
                android:progressDrawable="@android:color/transparent"
                android:splitTrack="false" />

            <EditText
                android:id="@+id/etBet1"
                android:layout_width="65dp"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:backgroundTint="@android:color/white"
                android:hint="Cược"
                android:inputType="number"
                android:textColor="@android:color/white" />
        </RelativeLayout>

        <!-- Ngựa 2: Đen -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="0dp">

            <CheckBox
                android:id="@+id/cbHorse2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:buttonTint="@android:color/white" />

            <SeekBar
                android:id="@+id/sbHorse2"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_toStartOf="@+id/etBet2"
                android:layout_toEndOf="@id/cbHorse2"
                android:enabled="false"
                android:max="100"
                android:progressDrawable="@android:color/transparent"
                android:splitTrack="false" />

            <EditText
                android:id="@+id/etBet2"
                android:layout_width="65dp"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:backgroundTint="@android:color/white"
                android:hint="Cược"
                android:inputType="number"
                android:textColor="@android:color/white" />
        </RelativeLayout>


        <!-- Ngựa 3: Nâu -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="0dp">

            <CheckBox
                android:id="@+id/cbHorse3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:buttonTint="@android:color/white" />

            <SeekBar
                android:id="@+id/sbHorse3"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_toStartOf="@+id/etBet3"
                android:layout_toEndOf="@id/cbHorse3"
                android:enabled="false"
                android:max="100"
                android:progressDrawable="@android:color/transparent"
                android:splitTrack="false" />

            <EditText
                android:id="@+id/etBet3"
                android:layout_width="65dp"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:backgroundTint="@android:color/white"
                android:hint="Cược"
                android:inputType="number"
                android:textColor="@android:color/white" />
        </RelativeLayout>

        <!-- Ngựa 4: Trắng -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="0dp">

            <CheckBox
                android:id="@+id/cbHorse4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:buttonTint="@android:color/white" />

            <SeekBar
                android:id="@+id/sbHorse4"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_toStartOf="@+id/etBet4"
                android:layout_toEndOf="@id/cbHorse4"
                android:enabled="false"
                android:max="100"
                android:progressDrawable="@android:color/transparent"
                android:splitTrack="false" />

            <EditText
                android:id="@+id/etBet4"
                android:layout_width="65dp"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:backgroundTint="@android:color/white"
                android:hint="Cược"
                android:inputType="number"
                android:textColor="@android:color/white" />
        </RelativeLayout>

    </LinearLayout>

    <!-- Thanh điều khiển phía dưới -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#AA000000"
        android:padding="15dp"
        android:gravity="center">
        <Button
            android:id="@+id/btnStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BẮT ĐẦU ĐUA"
            android:textStyle="bold"
            android:layout_marginEnd="15dp"
            android:backgroundTint="#FF9800"/>
        <Button
            android:id="@+id/btnReset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LÀM MỚI"
            android:backgroundTint="#757575"/>
    </LinearLayout>
</RelativeLayout>