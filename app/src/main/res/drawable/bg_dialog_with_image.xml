<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background Image -->
    <item>
        <bitmap
            android:src="@drawable/blankbg"
            android:gravity="fill"/>
    </item>
    
    <!-- Border overlay -->
    <item>
        <shape>
            <stroke 
                android:width="2dp" 
                android:color="#D4AF37"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
</layer-list>
